# WidgetStore API - run Docker, the API and the Functions first.

@baseUrl = http://localhost:5087
@month = 2026-11
# Paste the orderId from 3.1 and 4.2 here
@orderId = fd3277c708894a26a38c8a8f1475c739
@rejectedOrderId = f220bc08355e4f7da1bdf4546304af35


# 1. Products (Azure SQL)

### 1.1 All products
GET {{baseUrl}}/api/products

### 1.2 Products in one category
GET {{baseUrl}}/api/products?category=widgets


# 2. Product images (Blob Storage)

### 2.1 Upload image Widget Basic
POST {{baseUrl}}/api/products/1/image
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="widget-basic.png"
Content-Type: image/png

< ../TestData/Images/widget-basic.png
--WebAppBoundary--

### 2.2 Upload image Widget Pro
POST {{baseUrl}}/api/products/2/image
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="widget-pro.png"
Content-Type: image/png

< ../TestData/Images/widget-pro.png
--WebAppBoundary--

### 2.3 Upload image Widget Mini
POST {{baseUrl}}/api/products/3/image
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
